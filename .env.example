# Modèle de configuration à copier vers .env pour le développement.
# Uvicorn le charge avec --env-file .env ; Settings.from_env valide les valeurs.
# Docker Compose le transmet aussi à l’API s’il existe, en adaptant la connexion Redis.
# Les durées ci-dessous sont en secondes et les listes sont séparées par des virgules.

# Origines exactes du frontend autorisées par CORS, sans chemin supplémentaire.
FRONTEND_ORIGINS=http://localhost:5173
# Adresse utilisée quand Uvicorn tourne sur le poste hôte. Docker Compose la remplace
# par redis://redis:6379/0 pour joindre le service Redis depuis le conteneur API.
REDIS_URL=redis://127.0.0.1:6379/0
# Préfixe commun aux caches, verrous et compteurs de ce déploiement.
REDIS_KEY_PREFIX=mouvair
# closed bloque les appels fournisseur si Redis est indisponible.
# local autorise des compteurs propres au processus pour le développement.
REDIS_FAILURE_MODE=closed
# Délais courts pour limiter l’attente réseau Redis et pause entre les tentatives en panne.
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_RETRY_DELAY_SECONDS=5
# Borne du pool de connexions Redis de chaque processus API.
REDIS_MAX_CONNECTIONS=20
# À remplacer par un secret aléatoire long ; sert au HMAC de l’identité réseau des clients.
CLIENT_ID_HMAC_SECRET=replace-with-a-long-random-secret
# Réseaux CIDR des proxies autorisés à fournir X-Real-IP ou X-Forwarded-For.
# Vide en accès direct local ; ne déclarer ici que les réseaux réellement fiables.
TRUSTED_PROXY_CIDRS=

# Périmètre partagé par toutes les instances consommant le même budget fournisseur.
OPEN_METEO_QUOTA_SCOPE=free-api
# Seuils de réservation sur fenêtres glissantes : minute, heure, jour et 31 jours.
# Un géocodage coûte 1, une récupération météo + air coûte 2, un cache hit coûte 0.
OPEN_METEO_QUOTA_MINUTE=540
OPEN_METEO_QUOTA_HOUR=4500
OPEN_METEO_QUOTA_DAY=9000
OPEN_METEO_QUOTA_MONTH=270000

# Résultats de recherche conservés 24 h ; une liste vide expire après 5 min.
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_NEGATIVE_CACHE_TTL_SECONDS=300
# Capacité du LRU mémoire de chaque processus, en nombre de recherches distinctes.
GEOCODING_LOCAL_CACHE_MAX_ENTRIES=512
# Durée de possession du verrou distribué puis attente maximale d’un autre demandeur.
GEOCODING_LOCK_TTL_SECONDS=12
GEOCODING_LOCK_WAIT_SECONDS=4

# Conservation Redis de 24 h pour le repli, distincte de la fraîcheur métier de 15 min.
FORECAST_SHARED_CACHE_TTL_SECONDS=86400
# Verrou de récupération d’une position et attente maximale d’une récupération concurrente.
FORECAST_LOCK_TTL_SECONDS=20
FORECAST_LOCK_WAIT_SECONDS=6

# Limites entrantes par identité réseau, y compris quand la réponse vient du cache.
# Les budgets des recherches et des prévisions sont indépendants.
LOCATION_RATE_LIMIT_MINUTE=120
LOCATION_RATE_LIMIT_HOUR=1200
FORECAST_RATE_LIMIT_MINUTE=40
FORECAST_RATE_LIMIT_HOUR=240
